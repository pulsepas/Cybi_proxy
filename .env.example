PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Bearer token required by clients. 32+ random chars.
# Generate: openssl rand -hex 32
CLIENT_TOKEN=replace-with-32-char-random-string-xxxxxxxxxxxx

# Deepgram (required for STT)
DEEPGRAM_API_KEY=

# LLM (optional; when set, POST /v1/llm/messages will be enabled later)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# CORS: comma-separated origins. Use * only for local dev.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Daily caps
STT_DAILY_MINUTES_CAP=600
LLM_DAILY_TOKENS_CAP=2000000
